{
  "name": "whatsapp-watch-trading-engine",
  "version": "10.2.0",
  "description": "Production-grade luxury watch trading engine with AI analysis for WhatsApp groups",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "api": "cd python && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:full": "concurrently \"npm run api\" \"npm run dev\"",
    "test": "jest --verbose",
    "lint": "eslint server.js",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "watch-trading",
    "luxury-watches",
    "ai",
    "openai",
    "gpt-4",
    "fastapi",
    "trading-engine"
  ],
  "author": "Watch Trading Desk <engineering@watchtrading.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/whatsapp-watch-trading-engine.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/whatsapp-watch-trading-engine/issues"
  },
  "homepage": "https://github.com/yourusername/whatsapp-watch-trading-engine#readme",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.8",
    "@hapi/boom": "^10.0.1",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0",
    "node-cron": "^3.0.3",
    "joi": "^17.13.0",
    "uuid": "^9.0.1",
    "prom-client": "^15.1.0",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "rate-limiter-flexible": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "@types/node": "^20.11.5",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
