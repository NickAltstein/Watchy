# WhatsApp Scraper Configuration

# ============================================
# REDIS CONFIGURATION (for session storage)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Set to 'true' to use file-based auth instead of Redis
# Useful for single-instance deployments
USE_FILE_AUTH=false

# ============================================
# API CONFIGURATION
# ============================================
PYTHON_API_URL=http://localhost:8000
API_TIMEOUT=10000
API_MAX_RETRIES=3

# ============================================
# WHATSAPP CONFIGURATION
# ============================================
# Unique session ID for multi-instance support
SESSION_ID=default

# Comma-separated list of group names to monitor
# Leave empty to monitor all groups
WATCHED_GROUPS=

# Maximum image size in MB
MAX_IMAGE_SIZE_MB=5

# Reconnection settings
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_INTERVAL=10000

# ============================================
# QUEUE CONFIGURATION
# ============================================
# Number of concurrent messages to process
QUEUE_CONCURRENCY=1

# ============================================
# HEALTH SERVER CONFIGURATION
# ============================================
HEALTH_PORT=3000

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_METRICS=true
ENABLE_HEALTH_SERVER=true
ENABLE_QUEUE=true

# ============================================
# LOGGING
# ============================================
# Levels: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# PYTHON API CONFIGURATION (for main.py)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ADMIN_SECRET=your_admin_secret_here
DATABASE_URL=trade_desk.db
DEBUG=false
