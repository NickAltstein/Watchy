# ==========================================
# WATCH TRADING ENGINE - CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# API KEYS (REQUIRED)
# ==========================================
# OpenAI API key for GPT-4o Vision (image analysis)
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepSeek API key for text-only analysis (cost-effective)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Admin secret for protected endpoints (min 16 characters)
# Generate with: openssl rand -hex 32
ADMIN_SECRET=your-secure-admin-secret-min-16-chars

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# SQLite database file path
DATABASE_URL=trade_desk.db

# Debug mode (true/false) - uses in-memory database if true
DEBUG=false

# Database connection pool settings
DB_POOL_MINSIZE=1
DB_POOL_MAXSIZE=10

# ==========================================
# WHATSAPP CONFIGURATION
# ==========================================
# Python API URL (where FastAPI is running)
PYTHON_API_URL=http://localhost:8000

# Comma-separated list of WhatsApp group names to monitor
# Leave empty to monitor all groups
WATCHED_GROUPS=

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Maximum reconnection attempts before giving up
WHATSAPP_MAX_RECONNECT_ATTEMPTS=10

# Reconnection interval in milliseconds
WHATSAPP_RECONNECT_INTERVAL=10000

# Maximum retries for API calls
MAX_RETRIES=3

# Request timeout in milliseconds
REQUEST_TIMEOUT=10000

# Maximum image size in MB
MAX_IMAGE_SIZE_MB=5

# Enable Prometheus metrics endpoint
ENABLE_METRICS=false

# ==========================================
# SECURITY & PERFORMANCE
# ==========================================
# Maximum text length to process
MAX_TEXT_LENGTH=2000

# Maximum image size in bytes (base64 encoded)
# Default: 5MB * 1.37 (base64 overhead)
MAX_IMAGE_SIZE_BYTES=6850000

# AI processing timeout in seconds
AI_TIMEOUT=18.0

# Deduplication time window in hours
DEDUPE_HOURS=4

# Deal score calculation multiplier
SCORE_MULTIPLIER=1000

# Minimum price drift percentage to flag
DRIFT_MIN_PERCENT=2.0

# Cache refresh interval in seconds
REFRESH_CACHE_INTERVAL=600

# ==========================================
# ALERT THRESHOLDS
# ==========================================
# Minimum score for URGENT alerts (high priority deals)
URGENT_ALERT_MIN=350

# Minimum score for PUSH notifications
PUSH_ALERT_MIN=200

# ==========================================
# RATE LIMITING
# ==========================================
# Rate limit for /parse-watch endpoint
PARSE_RATE_LIMIT=20/minute

# Rate limit for /metrics endpoint
METRICS_RATE_LIMIT=10/minute

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Comma-separated list of allowed origins
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=*

# ==========================================
# NOTIFICATION SETTINGS (OPTIONAL)
# ==========================================
# Discord webhook URL for hot deal alerts
DISCORD_WEBHOOK_URL=

# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=

# Email settings for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Telegram bot settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Log file rotation settings
LOG_MAX_SIZE=10M
LOG_MAX_FILES=10

# Enable detailed SQL query logging
SQL_ECHO=false
