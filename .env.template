# ============================================
# WATCHY - LUXURY WATCH TRADING PLATFORM
# Environment Configuration Template
# ============================================
# Copy this file to .env and update with your values
# Required variables are marked with [REQUIRED]
# Optional variables have sensible defaults

# ===== AI & ML PROVIDERS =====
# OpenAI (GPT-4 Vision for image parsing) [REQUIRED]
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# DeepSeek (Cost-effective text parsing fallback)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.1

# Anthropic Claude (Advanced reasoning for complex cases)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AI Configuration
AI_TIMEOUT_SECONDS=18.0
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_SECONDS=2.0
AI_COST_LIMIT_DAILY_USD=100.0

# ===== DATABASE CONFIGURATION =====
# PostgreSQL (Primary database with TimescaleDB extension) [REQUIRED]
DATABASE_URL=postgresql://watchy_user:secure_password@localhost:5432/watchy_prod
POSTGRES_DB=watchy_trading
POSTGRES_USER=watchy
POSTGRES_PASSWORD=watchy_dev_password_CHANGE_ME
POSTGRES_PORT=5432
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false  # Set to true for SQL debugging

# Redis (Caching, pub/sub, rate limiting) [REQUIRED]
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=50
REDIS_CACHE_TTL_SECONDS=600  # 10 minutes default

# TimescaleDB Configuration
TIMESCALE_CHUNK_TIME_INTERVAL=1 day
TIMESCALE_RETENTION_POLICY=2 years

# ===== SECURITY & AUTHENTICATION =====
# Admin Secret (min 32 characters) [REQUIRED]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=CHANGE_ME_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# JWT Configuration
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys for External Access
API_KEY_MASTER=CHANGE_ME_MASTER_API_KEY
API_KEY_SALT=CHANGE_ME_SALT_FOR_HASHING

# Password Hashing
BCRYPT_ROUNDS=12

# CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost
# Production: https://yourdomain.com,https://api.yourdomain.com

# ===== WHATSAPP CONFIGURATION =====
# WhatsApp Groups to Monitor (comma-separated group IDs)
WHATSAPP_GROUPS=120363123456789012@g.us,120363987654321098@g.us
WHATSAPP_SCAN_INTERVAL_SECONDS=30
WHATSAPP_MAX_MESSAGES_PER_SCAN=50
WHATSAPP_COOLDOWN_SECONDS=5

# Baileys Configuration
BAILEYS_BROWSER_NAME=Watchy
BAILEYS_BROWSER_VERSION=1.0.0
BAILEYS_RECONNECT_INTERVAL_MS=5000
BAILEYS_MAX_RECONNECT_ATTEMPTS=10

# ===== DEAL SCORING CONFIGURATION =====
# Score Thresholds (range: -500 to +500)
SCORE_URGENT_THRESHOLD=350
SCORE_PUSH_THRESHOLD=200
SCORE_NORMAL_THRESHOLD=50
SCORE_SKIP_THRESHOLD=-50

# Score Component Multipliers (default: 1.0)
SCORE_MULTIPLIER_CONDITION=1.0
SCORE_MULTIPLIER_INCLUSIONS=1.0
SCORE_MULTIPLIER_SELLER=1.0
SCORE_MULTIPLIER_URGENCY=1.0
SCORE_MULTIPLIER_TREND=1.0
SCORE_MULTIPLIER_RARITY=1.0

# Risk Assessment
RISK_PENALTY_MAX=50
RISK_KEYWORDS=cash only,wire transfer,urgent sale,must sell today

# ===== MARKET DATA & PRICING =====
# Target Prices File
TARGET_PRICES_FILE=target_prices.json
AUTO_UPDATE_TARGET_PRICES=true
TARGET_PRICES_UPDATE_INTERVAL_HOURS=24

# Price History Configuration
PRICE_HISTORY_DEFAULT_DAYS=90
PRICE_HISTORY_MAX_DAYS=365
PRICE_PREDICTION_DAYS=30
BOLLINGER_BANDS_WINDOW=20
BOLLINGER_BANDS_STD_DEV=2

# External Market Data APIs (Optional)
CHRONO24_API_KEY=
WATCHBOX_API_KEY=
WATCHCHARTS_API_KEY=

# ===== CACHING & PERFORMANCE =====
# Cache TTL Values (seconds)
CACHE_TTL_MARKET_PRICES=600  # 10 minutes
CACHE_TTL_DEAL_SCORES=300    # 5 minutes
CACHE_TTL_PRICE_HISTORY=1800 # 30 minutes
CACHE_TTL_ANALYTICS=900      # 15 minutes

# Connection Pooling
API_MAX_WORKERS=10
CELERY_WORKER_CONCURRENCY=4

# ===== RATE LIMITING =====
# Per-Endpoint Rate Limits (requests per minute)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_PARSE_WATCH=20
RATE_LIMIT_SCORE_DEAL=50
RATE_LIMIT_PRICE_HISTORY=30
RATE_LIMIT_COMPARE_REFERENCES=10

# Rate Limit Storage
RATE_LIMIT_STORAGE=redis
RATE_LIMIT_KEY_PREFIX=watchy_rl:

# ===== MONITORING & OBSERVABILITY =====
# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_RETENTION_DAYS=15

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_CHANGE_ME
GRAFANA_ROOT_URL=http://localhost:3001

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json # json or plain
LOG_FILE=logs/watchy.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# ===== APPLICATION CONFIGURATION =====
# Environment
NODE_ENV=development  # development, staging, production
DEBUG=true
ENVIRONMENT=development

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# API Configuration
API_PREFIX=/api/v1
API_TITLE=Watchy Trading API
API_DESCRIPTION=Luxury Watch Trading Platform API
API_VERSION=1.0.0
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_SITE_NAME=Watchy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== CELERY BACKGROUND TASKS =====
# Broker & Backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Task Configuration
CELERY_TASK_ALWAYS_EAGER=false  # Set to true for synchronous testing
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Scheduled Tasks (cron format)
CELERY_BEAT_UPDATE_MARKET_PRICES=*/10 * * * *  # Every 10 minutes
CELERY_BEAT_CLEANUP_OLD_DATA=0 2 * * *         # Daily at 2 AM
CELERY_BEAT_SEND_ALERTS=*/5 * * * *            # Every 5 minutes

# ===== ALERTING & NOTIFICATIONS =====
# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Watchy <notifications@yourdomain.com>
SMTP_USE_TLS=true

# Webhook Notifications
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
WEBHOOK_RETRY_ATTEMPTS=3

# Push Notifications
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_CREDENTIALS_FILE=firebase-credentials.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Alert Thresholds
ALERT_ERROR_RATE_THRESHOLD=0.01  # 1%
ALERT_RESPONSE_TIME_P95_MS=500
ALERT_QUEUE_DEPTH_THRESHOLD=5000
ALERT_DB_CONNECTION_THRESHOLD=0.8  # 80%
ALERT_API_COST_HOURLY_USD=100
ALERT_NO_MESSAGES_MINUTES=5

# ===== DOCKER & DEPLOYMENT =====
# Docker Compose
COMPOSE_PROJECT_NAME=watchy
COMPOSE_FILE=docker-compose.yml

# Docker Resource Limits
BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=2G
FRONTEND_CPU_LIMIT=1
FRONTEND_MEMORY_LIMIT=1G
POSTGRES_MEMORY_LIMIT=4G
REDIS_MEMORY_LIMIT=1G

# Restart Policy
RESTART_POLICY=unless-stopped  # no, on-failure, always, unless-stopped

# ===== PYTHON & NODE VERSIONS =====
PYTHON_VERSION=3.11
NODE_VERSION=18

# ===== FEATURE FLAGS =====
# Enable/Disable Features
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_PRICE_PREDICTIONS=true
FEATURE_MULTI_SOURCE_SCRAPING=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MOBILE_API=true
FEATURE_EXPORT_REPORTS=true

# Experimental Features (use with caution)
EXPERIMENTAL_ML_PRICE_MODELING=false
EXPERIMENTAL_SENTIMENT_ANALYSIS=false
EXPERIMENTAL_BLOCKCHAIN_INTEGRATION=false

# ===== TESTING =====
# Test Database (separate from production)
TEST_DATABASE_URL=postgresql://watchy_test:test_pass@localhost:5432/watchy_test
TEST_REDIS_URL=redis://localhost:6379/15

# Test Configuration
TEST_SKIP_SLOW=false
TEST_PARALLEL_WORKERS=auto
TEST_COVERAGE_THRESHOLD=80

# ===== PRODUCTION OVERRIDES =====
# Uncomment and configure for production deployment
# DEBUG=false
# LOG_LEVEL=WARNING
# NODE_ENV=production
# ENVIRONMENT=production
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ===== SECURITY REMINDERS =====
# 1. Never commit .env files to version control
# 2. Use strong, randomly generated secrets (min 32 characters)
# 3. Rotate API keys and secrets regularly
# 4. Use environment-specific configurations
# 5. Enable rate limiting in production
# 6. Use HTTPS/TLS in production
# 7. Restrict CORS origins to your domains only
# 8. Monitor and alert on suspicious activity
# 9. Keep dependencies updated
# 10. Regular security audits

# ===== QUICK SETUP COMMANDS =====
# Generate secure random strings:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Test database connection:
#   psql $DATABASE_URL -c "SELECT version();"
#
# Verify Redis connection:
#   redis-cli -u $REDIS_URL ping
#
# Start all services:
#   docker-compose up -d
#
# View logs:
#   docker-compose logs -f backend
#
# Run migrations:
#   python manage.py migrate
#
# Create admin user:
#   python manage.py createsuperuser
