# Frontend Dockerfile for Next.js Application
ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --only=production && \
    npm cache clean --force

# Copy application code
COPY frontend/ ./

# Build application
RUN npm run build

# Production stage
FROM node:${NODE_VERSION}-alpine

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init curl

# Create non-root user
RUN addgroup -g 1000 watchy && \
    adduser -D -u 1000 -G watchy watchy

WORKDIR /app

# Copy built application from builder
COPY --from=builder --chown=watchy:watchy /app/.next ./.next
COPY --from=builder --chown=watchy:watchy /app/node_modules ./node_modules
COPY --from=builder --chown=watchy:watchy /app/package*.json ./
COPY --from=builder --chown=watchy:watchy /app/public ./public

# Switch to non-root user
USER watchy

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Run application with dumb-init
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "start"]
